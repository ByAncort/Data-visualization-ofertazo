table Calendario
	lineageTag: cff09ed8-78e1-4215-befd-7314a9cb9963
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: 4e31087d-540e-4e1e-96d2-6115f5da7a3e
		summarizeBy: none
		sourceColumn: Fecha

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Año
		dataType: int64
		formatString: 0
		lineageTag: 99a146eb-1bc7-4e01-bce1-70bab564085d
		summarizeBy: none
		sourceColumn: Año

		annotation SummarizationSetBy = Automatic

	column 'Mes Número'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 334b5ed0-4629-4167-a2bb-8bc48450b4f3
		summarizeBy: none
		sourceColumn: Mes Número

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: e0c92619-4ba4-4c2f-89d8-cc47a99ce2b5
		summarizeBy: none
		sourceColumn: Mes
		sortByColumn: 'Mes Número'

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: 761e1c78-5c3f-48af-b813-95e976d87c59
		summarizeBy: none
		sourceColumn: Trimestre

		annotation SummarizationSetBy = Automatic

	partition Calendario = m
		mode: import
		source =
				let
				    // Calendario continuo que cubre todos los años de incorporación del catálogo
				    FechaMin = List.Min(Contenido_Base[Fecha Incorporación]),
				    FechaMax = List.Max(Contenido_Base[Fecha Incorporación]),
				    Inicio = #date(Date.Year(FechaMin), 1, 1),
				    Fin = #date(Date.Year(FechaMax), 12, 31),
				    Fechas = List.Dates(Inicio, Duration.Days(Fin - Inicio) + 1, #duration(1, 0, 0, 0)),
				    Tabla = Table.FromList(Fechas, Splitter.SplitByNothing(), {"Fecha"}),
				    TipoFecha = Table.TransformColumnTypes(Tabla, {{"Fecha", type date}}),
				    ConAnio = Table.AddColumn(TipoFecha, "Año", each Date.Year([Fecha]), Int64.Type),
				    ConMesNum = Table.AddColumn(ConAnio, "Mes Número", each Date.Month([Fecha]), Int64.Type),
				    ConMes = Table.AddColumn(ConMesNum, "Mes", each Text.Proper(Date.ToText([Fecha], [Format = "MMM", Culture = "es-CL"])), type text),
				    ConTrimestre = Table.AddColumn(ConMes, "Trimestre", each "T" & Text.From(Date.QuarterOfYear([Fecha])), type text)
				in
				    ConTrimestre

	annotation PBI_ResultType = Table

